# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# --- BACKEND (Node.js Express) ---
PORT=5000
NODE_ENV=production
# Connection string for your cloud MongoDB (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/socialmedia?retryWrites=true&w=majority
# Strong secret key for signing JWT auth tokens
JWT_SECRET=generate-a-strong-random-32-char-secret-key-here
# URL of your deployed Frontend (for CORS allowlist, comma-separated if multiple)
CLIENT_URL=https://your-app-name.vercel.app,https://your-app-name.onrender.com
# URL of your deployed ML Service
ML_API_URL=https://your-ml-service.onrender.com
# Optional Redis URL (e.g. Upstash Redis)
REDIS_URL=redis://default:<password>@<host>:<port>

# --- FRONTEND (React / Vite) ---
# The URL pointing to your deployed backend API (used during build time)
VITE_API_URL=https://your-backend-api.onrender.com/api
# The URL pointing to your deployed ML service
VITE_ML_API_URL=https://your-ml-service.onrender.com

# --- ML SERVICE (Python FastAPI) ---
PORT=8000
